{
  "name": "v1",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:https": "ng serve --ssl --host 0.0.0.0",
    "verify": "esbuild tools/verify.ts --bundle --platform=node --format=esm --outfile=.verify.mjs --log-level=warning && node --import ./tools/polyfill.mjs .verify.mjs",
    "fakecam": "esbuild tools/fakecam.ts --bundle --platform=node --format=esm --outfile=.fakecam.mjs --log-level=warning && node .fakecam.mjs /tmp/pano.y4m",
    "e2e": "node tools/e2e.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tools/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tools/**/*.{ts,mjs}\""
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}